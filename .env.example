# Environment Variables
# Copy this file to .env.local and fill in the values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
    

# GitHub (optional — for contribution graph API)
GITHUB_TOKEN=ghp_xxx

# Cloudflare Turnstile — sadece SITE key client'a gider
NEXT_PUBLIC_TURNSTILE_SITE_KEY= xxx_xxx
# Turnstile SECRET key buraya KONMAZ ve ASLA NEXT_PUBLIC_ önekiyle tanımlanmaz
# (client bundle'a sızar). Doğrulama Supabase Auth sunucusunda yapılır;
# secret sadece Supabase Dashboard > Authentication > Bot & Abuse Protection
# ayarlarında kalır.